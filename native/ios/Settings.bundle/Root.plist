<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iPhone Settings → Kinwall: the chore nudge (src/reminders.ts reads it), and how to delete the family's account (App Store 5.1.1(v)). Accounts
     are made on the family's Kinwall server, not in the app, so deleting one happens there too. -->
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Chore nudge</string>
			<key>FooterText</key>
			<string>Once a day, how many of your chores are left, with Done when it's just one. Only on your own iPhone (Kinwall → Settings → Access → Who uses it).</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Chore nudge</string>
			<key>Key</key>
			<string>choreNudge</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Time</string>
			<key>Key</key>
			<string>choreNudgeTime</string>
			<key>DefaultValue</key>
			<string>08:00</string>
			<key>Titles</key>
			<array><string>7:00 AM</string><string>8:00 AM</string><string>3:30 PM</string><string>5:00 PM</string><string>7:00 PM</string></array>
			<key>Values</key>
			<array><string>07:00</string><string>08:00</string><string>15:30</string><string>17:00</string><string>19:00</string></array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Deleting your family's account</string>
			<key>FooterText</key>
			<string>Hosted Kinwall: in Kinwall, open Settings → Access → Your data → Manage or delete this family. Your own server: your family's data lives there, so you delete it there (docs.kinwall.family, Deleting everything). Signing out of this app only removes this iPhone's sign-in.</string>
		</dict>
	</array>
</dict>
</plist>
